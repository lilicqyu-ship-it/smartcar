.DS_Store
.zcode/

# firmware/dist：固件镜像（hex/bin）+ manifest.json 入库做版本管理；
# elf/map/mdf 是调试符号（单个 elf ~2MB），只留本地不入库
firmware/dist/**/*.elf
firmware/dist/**/*.map
firmware/dist/**/*.mdf
.codegraph/
.kiro/
/firmware/__pycache__/*.pyc
/firmware/dist/esp32c6_car
/firmware/dist/smartcar_remote
# ESP 工程的归档不入 git（体积走 CI artifact / Release 附件，同一份 bin 不放两处）
/firmware/dist/s3-gateway
# 外部工具残留的差异文件（TortoiseGit/对比工具临时补丁等）
*.diff
smartcar_remote/.cache
# clangd/工具链本地缓存
tc275_car/.cache/
/firmware/dist
