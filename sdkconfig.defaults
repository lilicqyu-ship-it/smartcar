# ---- target / flash ----------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- partition table ----------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (N16R8 module, octal 8 MB) ------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# XIP_FROM_PSRAM (official esp-dev-kits lvgl_demos): code+rodata run from PSRAM so
# flash writes (NVS, Wi-Fi PHY calibration) no longer disable the cache.  Without
# it the RGB bounce ISR cannot read the PSRAM framebuffer during a flash op and
# the panel drifts / shows snow.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Wi-Fi driver must not persist its config to NVS: it rewrites flash on every
# (re)connect, and each flash write disturbs the RGB bounce-buffer scan-out
# (glitch / pink frame during link flaps).  The STA config is set from
# scr_settings on every boot anyway.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- CPU / RTOS ------------------------------------------------------------------
# NOTE: symbol is ..._FREQ_MHZ_240 - the old "_FREQ_240" name was silently
# ignored and the chip ran at 160 MHz, starving the RGB bounce-buffer ISR.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 64 KB / 64 B data cache (Espressif LCD-EV-Board RGB config): PSRAM->bounce
# buffer memcpy bandwidth.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
# doc/08 §2: core 0 = comms/service, core 1 = ctrl + LVGL only.  lwIP must not
# float onto core 1 where it would preempt the LVGL/bounce-buffer feed.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- watchdogs / panic -------------------------------------------------------------
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_BROWNOUT_DET=y

# ---- networking ---------------------------------------------------------------------
CONFIG_LWIP_SO_REUSE=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# Separate TX lock: the 30 Hz DRIVE writes must not serialize the client's
# receive loop / keep-alive PONG responses (real-board log: PONG lock
# timeouts while driving data flows).
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=100

# ---- logging: INFO on the bench, screen stays clean (spec section 7) ---------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- BSP: ESP32-S3-LCD-EV-Board-2, sub board 3 = 4.3" 800x480 RGB (ST7262) --------
# Hardware: ESP32-S3-LCD-EV-Board-2 kit (SUB3), GT1151 touch, N16R16V module.
CONFIG_BSP_LCD_SUB_BOARD_800_480=y
# Anti-tearing (Espressif factory_demo config for this board): full frame
# buffers in PSRAM + bounce buffers.  Without anti-tear, LVGL partial redraws
# race the RGB scan-out and the picture visibly tears/shakes.
# DIRECT_MODE (not FULL_REFRESH): full refresh repaints the whole 800x480 for
# every dirty pixel group - with a 10 Hz updater that strobes the panel.  Direct
# mode redraws only the dirty regions into the vsync-synchronized buffer.
# BUFFER_NUMS=3: matches the official esp-dev-kits lvgl_demos config.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=3
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
# Bounce buffer height 20 (BSP default 10): halves the bounce-feed interrupt
# rate for more headroom under Wi-Fi load.
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=y
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
# Do NOT enable CONFIG_LCD_RGB_RESTART_IN_VSYNC (R-11, reverted): forcing a
# GDMA/FIFO reset every VBlank in bounce-buffer mode produced snow/garbage
# pixels on this board (real-hardware test 2026-09-29).

# ---- LVGL fonts used by the UI hierarchy (spec 54) ---------------------------------
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 10 pages with several hundred styled objects far exceed the builtin 64 KB
# pool (real-board panic: lv_realloc NULL -> LoadProhibited in lv_obj_add_style).
# LVGL heap = PSRAM first (main/lv_mem_psram.c).  The C-library allocator put
# every widget in internal RAM first; with the service pages it drained
# internal RAM to 0 and esp_wifi_init() aborted (NO_MEM reboot loop).
# (LV_USE_STDLIB_MALLOC is a derived int symbol - the user-facing knob is the
# "Malloc functions source" choice.)
CONFIG_LV_USE_CUSTOM_MALLOC=y
