# ---- target / flash ----------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- partition table ----------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (N16R8 module, octal 8 MB) ------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 120 MHz octal PSRAM/flash was bench-tested and REJECTED: this module's flash
# model has no HPM support (bootloader warns), and at 120 MHz the WiFi/TCP path
# degraded immediately (control-frame TX skips, ~360 ms WS pings).  All video
# wins live in the JPEG decoder config below, not in these clocks.
# XIP_FROM_PSRAM (official esp-dev-kits lvgl_demos): code+rodata run from PSRAM so
# flash writes (NVS, Wi-Fi PHY calibration) no longer disable the cache.  Without
# it the RGB bounce ISR cannot read the PSRAM framebuffer during a flash op and
# the panel drifts / shows snow.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Wi-Fi driver must not persist its config to NVS: it rewrites flash on every
# (re)connect, and each flash write disturbs the RGB bounce-buffer scan-out
# (glitch / pink frame during link flaps).  The STA config is set from
# scr_settings on every boot anyway.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- CPU / RTOS ------------------------------------------------------------------
# NOTE: symbol is ..._FREQ_MHZ_240 - the old "_FREQ_240" name was silently
# ignored and the chip ran at 160 MHz, starving the RGB bounce-buffer ISR.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 64 KB / 64 B data cache (Espressif LCD-EV-Board RGB config): PSRAM->bounce
# buffer memcpy bandwidth.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
# doc/08 §2: core 0 = comms/service, core 1 = ctrl + LVGL only.  lwIP must not
# float onto core 1 where it would preempt the LVGL/bounce-buffer feed.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- watchdogs / panic -------------------------------------------------------------
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_BROWNOUT_DET=y

# ---- networking ---------------------------------------------------------------------
CONFIG_LWIP_SO_REUSE=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# Separate TX lock: the 30 Hz DRIVE writes must not serialize the client's
# receive loop / keep-alive PONG responses (real-board log: PONG lock
# timeouts while driving data flows).
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=100

# ---- logging: INFO on the bench, screen stays clean (spec section 7) ---------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- BSP: ESP32-S3-LCD-EV-Board-2, sub board 3 = 4.3" 800x480 RGB (ST7262) --------
# Hardware: ESP32-S3-LCD-EV-Board-2 kit (SUB3), GT1151 touch, N16R16V module.
CONFIG_BSP_LCD_SUB_BOARD_800_480=y
# Anti-tearing (Espressif factory_demo config for this board): full frame
# buffers in PSRAM + bounce buffers.  Without anti-tear, LVGL partial redraws
# race the RGB scan-out and the picture visibly tears/shakes.
# DIRECT_MODE (not FULL_REFRESH): full refresh repaints the whole 800x480 for
# every dirty pixel group - with a 10 Hz updater that strobes the panel.  Direct
# mode redraws only the dirty regions into the vsync-synchronized buffer.
# BUFFER_NUMS=3: matches the official esp-dev-kits lvgl_demos config.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=3
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
# Bounce buffer height 20 (BSP default 10): halves the bounce-feed interrupt
# rate for more headroom under Wi-Fi load.
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=y
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
# Do NOT enable CONFIG_LCD_RGB_RESTART_IN_VSYNC (R-11, reverted): forcing a
# GDMA/FIFO reset every VBlank in bounce-buffer mode produced snow/garbage
# pixels on this board (real-hardware test 2026-09-29).

# Render as soon as a frame is dirty: the 35 Hz panel vsync (DIRECT_MODE flush
# waits for it) is the real cap; a 33 ms LVGL period added up to a frame of lag.
CONFIG_LV_DEF_REFR_PERIOD=16

# ---- LVGL default theme: dark mode -------------------------------------------------
# The UI is a custom dark HUD (ui_theme.h UI_COL_BG = 0x060A12).  Without this the
# default theme runs in LIGHT mode and bakes text_color = darken(grey,4) = 0x212121
# into every plain lv_obj container ('card' style) and button ('btn' style), so any
# label without an explicit colour (boot screen stage names, kv values, button
# captions) renders near-black on the near-black background.
CONFIG_LV_THEME_DEFAULT_DARK=y

# ---- LVGL fonts used by the UI hierarchy (spec 54) ---------------------------------
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 10 pages with several hundred styled objects far exceed the builtin 64 KB
# pool (real-board panic: lv_realloc NULL -> LoadProhibited in lv_obj_add_style).
# LVGL heap = PSRAM first (main/lv_mem_psram.c).  The C-library allocator put
# every widget in internal RAM first; with the service pages it drained
# internal RAM to 0 and esp_wifi_init() aborted (NO_MEM reboot loop).
# (LV_USE_STDLIB_MALLOC is a derived int symbol - the user-facing knob is the
# "Malloc functions source" choice.)
CONFIG_LV_USE_CUSTOM_MALLOC=y

# ---- Camera WS video plane ---------------------------------------------------
# S3-gateway (S3-CAM) video/vision plane: DEFAULT OFF.  The remote's primary
# link is the C6 (control / telemetry / pairing / OTA); with the master off,
# scr_cam, the CAMERA/VISION pages and the vision JSON all compile out.
# Flip to y only when a camera-equipped S3-gateway joins the vehicle.
# CONFIG_SCR_S3GW_ENABLE is not set
# Sensor QVGA delivers ~11.5 fps; the display cap must not clamp the honest
# reading to 10.0 (CONFIG only - the Kconfig default stays a conservative 10).
CONFIG_SCR_CAM_MAX_FPS=12

# ---- JPEG decoder -------------------------------------------------------------
# ESP32-S3 has no JPEG decode peripheral.  Primary path is esp_new_jpeg
# (S3 PIE SIMD, RGB565_LE, 16-byte-aligned slot buffers).  Espressif bench:
# 320x240 YUV420 -> RGB565_LE ~66 fps (~15 ms), under the 25 ms budget.
# TJpgDec stays as fallback (~35 ms QVGA on this board).
CONFIG_SCR_CAM_JPEG_SIMD=y
# Fallback TJpgDec: native RGB565 + table huffman.  Scratch is allocated
# lazily on the first software decode so a healthy SIMD path does not spend
# 64 KB of internal RAM.
# CONFIG_JD_USE_ROM is not set
CONFIG_JD_FORMAT_RGB565=y
CONFIG_JD_FASTDECODE_TABLE=y

# ---- Wi-Fi / lwIP receive path for the camera plane ---------------------------
# The 5760 B (4 x MSS) default window caps one TCP stream at ~window/RTT: at the
# 70-100 ms RTT seen under video that is ~60 KB/s, below WEB_PREVIEW's ~140 KB/s,
# so the gateway's send stalled (up to 2 s), the shared air backed up and the
# control WS hit its 150 ms write abort -> RADIO LOST + CAM OFF (bench 10-02).
# 16 x MSS window, wider A-MPDU RX block-ack, and lwIP/Wi-Fi buffers in PSRAM so
# the bigger window does not come out of the ~53 KB internal heap.
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=10
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
