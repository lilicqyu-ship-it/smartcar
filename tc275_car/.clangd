# clangd 配置 —— 编译数据库由 scripts/gen-tc275-cdb.py 生成到 build/compile_commands.json
# （宿主 clang + __HIGHTEC__ 路径解析；真实编译用 TASKING cctc，走 scons-car）

Diagnostics:
  Includes:
    IgnoreHeader:
      # IfxCpu_IntrinsicsHighTec2G.h 的 Ifx__* 内建包装函数体是 TriCore 专有
      # asm（寄存器名 a10/a11/d14…宿主 clang 不识别）。报错可恢复，声明/类型
      # 都在，只屏蔽这个头里的诊断。注意：clangd 此处按正则匹配绝对路径。
      - ".*IfxCpu_IntrinsicsHighTec2G\\.h"
